# Discord application credentials — Developer Portal → your app
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Register commands to one guild while developing: instant, no 1h cache wait.
# Leave blank to register globally.
DISCORD_GUILD_ID=

# Where the game lives
SITE_URL=https://clockthatdaily.com
# Shared secret for the bot-only API on the site. Must match BOT_API_SECRET there.
BOT_API_SECRET=
