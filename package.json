{
  "name": "clockthatdaily-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot for ClockThatDaily \u2014 the daily pop-culture gauntlet.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx --env-file-if-exists=.env src/smoke.ts",
    "register": "tsx --env-file-if-exists=.env src/deploy-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
